    (15) expresion -> expresion . MOD expresion

    PAR_DER         reduce using rule 15 (expresion -> expresion MOD expresion .)
    MAS             reduce using rule 15 (expresion -> expresion MOD expresion .)
    MENOS           reduce using rule 15 (expresion -> expresion MOD expresion .)
    POR             reduce using rule 15 (expresion -> expresion MOD expresion .)
    DIV             reduce using rule 15 (expresion -> expresion MOD expresion .)
    MOD             reduce using rule 15 (expresion -> expresion MOD expresion .)
    PUNTO_COMA      reduce using rule 15 (expresion -> expresion MOD expresion .)

  ! MAS             [ shift and go to state 29 ]
  ! MENOS           [ shift and go to state 30 ]
  ! POR             [ shift and go to state 31 ]
  ! DIV             [ shift and go to state 32 ]
  ! MOD             [ shift and go to state 33 ]


state 42

    (4) instruccion -> R_LET R_MUT ID DOS_PUNTOS tipo IGUAL expresion . PUNTO_COMA
    (11) expresion -> expresion . MAS expresion
    (12) expresion -> expresion . MENOS expresion
    (13) expresion -> expresion . POR expresion
    (14) expresion -> expresion . DIV expresion
    (15) expresion -> expresion . MOD expresion

    PUNTO_COMA      shift and go to state 44
    MAS             shift and go to state 29
    MENOS           shift and go to state 30
    POR             shift and go to state 31
    DIV             shift and go to state 32
    MOD             shift and go to state 33


state 43

    (5) instruccion -> R_LET ID DOS_PUNTOS tipo IGUAL expresion PUNTO_COMA .

    R_LET           reduce using rule 5 (instruccion -> R_LET ID DOS_PUNTOS tipo IGUAL expresion PUNTO_COMA .)
    R_PRINTLN       reduce using rule 5 (instruccion -> R_LET ID DOS_PUNTOS tipo IGUAL expresion PUNTO_COMA .)
    $end            reduce using rule 5 (instruccion -> R_LET ID DOS_PUNTOS tipo IGUAL expresion PUNTO_COMA .)


state 44

    (4) instruccion -> R_LET R_MUT ID DOS_PUNTOS tipo IGUAL expresion PUNTO_COMA .

    R_LET           reduce using rule 4 (instruccion -> R_LET R_MUT ID DOS_PUNTOS tipo IGUAL expresion PUNTO_COMA .)
    R_PRINTLN       reduce using rule 4 (instruccion -> R_LET R_MUT ID DOS_PUNTOS tipo IGUAL expresion PUNTO_COMA .)
    $end            reduce using rule 4 (instruccion -> R_LET R_MUT ID DOS_PUNTOS tipo IGUAL expresion PUNTO_COMA .)

